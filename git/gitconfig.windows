[push]
	default = nothing
[core]
	autocrlf = false
	ignorecase = false
	longpaths = true
	pager = delta
	# Windows' own OpenSSH, not Git's, which can't reach the ssh-agent service (SECURITY.md section 5)
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
[user]
	name = Lingnan Liu
	useConfigOnly = true
	signingkey = ~/.ssh/signing_key.pub
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[interactive]
	diffFilter = delta --color-only
[add.interactive]
	useBuiltin = false # required for git 2.37.0
[delta]
	navigate = true    # use n and N to move between diff sections
	light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	side-by-side = true
[commit]
	gpgsign = true
[rerere]
	enabled = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
[credential "helperselector"]
	selected = manager
